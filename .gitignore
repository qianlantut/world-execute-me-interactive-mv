# Local music and private recordings are never source-control inputs.
/music/*
!/music/README.md
*.m4a
*.mp3
*.wav
*.ogg
*.flac
*.mp4
*.webm
/dist/
/releases/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
node_modules/
playwright-report/
test-results/

# Versioned release source only: never commit working copies or generated builds.
**/dist/
**/music/*
!**/music/README.md
**/node_modules/
**/work/
**/_backup*/
**/recording*/
**/playwright-report/
**/test-results/
*.zip
*.rar
*.7z
*.log
*.tmp
*.bak
*.mov
*.mkv
